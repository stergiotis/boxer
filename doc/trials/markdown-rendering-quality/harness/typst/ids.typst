// pandoc template for the `typst-ids` arm (README §3): the native arm's
// type spec — its faces, body size, leading, reading column, dark page and
// inks — set by typst's own line breaker and justification. What the
// comparison isolates is the paragraph setter: the same specification, a
// Knuth–Plass breaker with hyphenation against egui's first-fit one.
//
// Units: the common viewport is 1000 × 1400 CSS px at 96 dpi, which is
// 750 × 1050 pt; 13 px is 9.75 pt; the 50 em column is 487.5 pt.
#let horizontalrule = line(length: 100%, stroke: 0.5pt + rgb("#2e3133"))
#let endnote(num, contents) = [#super[#num] #contents]
#show terms.item: it => block(spacing: 0.75em)[#strong[#it.term] #h(0.5em) #it.description]

#set page(width: 750pt, height: 1050pt, margin: (x: 131.25pt, top: 19.5pt, bottom: 19.5pt), fill: rgb("#0b0e0f"))
// A line's box runs from the face's ascender to its descender, as a CSS
// line box does; typst's default is cap height to baseline. Noto Sans
// spans 1.362 em that way, so the design system's 20 px = 15 pt step is
// that box plus 1.72 pt of leading.
#set text(font: "Noto Sans", size: 9.75pt, fill: rgb("#e5e8eb"), lang: "en", top-edge: "ascender", bottom-edge: "descender")
#set par(leading: 1.72pt, spacing: 7.3pt, justify: true)
#show heading: set text(fill: rgb("#f6f9fb"), weight: "bold")
#show heading.where(level: 1): set text(size: 16.5pt)
#show heading.where(level: 2): set text(size: 14.25pt)
#show heading.where(level: 3): set text(size: 12pt)
#show heading.where(level: 4): set text(size: 10.5pt)
#show heading: set block(above: 1.4em, below: 0.6em)
#show link: set text(fill: rgb("#6fc8ff"))
#show raw: set text(font: "DejaVu Sans Mono", size: 0.9em)
#show raw.where(block: false): it => box(fill: rgb("#1d2021"), inset: (x: 0.35em, y: 0.12em), radius: 2pt, it)
#show raw.where(block: true): it => block(fill: rgb("#1d2021"), inset: 12pt, radius: 4pt, width: 100%, it)
#show quote.where(block: true): it => block(stroke: (left: 2pt + rgb("#4a4e52")), inset: (left: 12pt, y: 2pt))[#set text(fill: rgb("#a8abae")); #it.body]
#show strike: set text(fill: rgb("#616466"))
#show highlight: set highlight(fill: rgb("#63512e"))
#show table: set text(size: 9.75pt)
#set table(stroke: 0.5pt + rgb("#2e3133"), inset: (x: 12pt, y: 4pt))

$body$
