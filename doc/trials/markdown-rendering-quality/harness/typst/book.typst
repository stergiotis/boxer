// pandoc template for the `typst-book` arm (README §3): typst's own book
// typography as the typographic ceiling — its bundled Libertinus Serif at
// 11 pt, a 66-character measure, justification with hyphenation, headings
// in the same face. Nothing of the native arm's specification is kept but
// the page size; the arm shows what a paragraph setter built for print
// does with the same text.
#let horizontalrule = line(start: (25%, 0%), end: (75%, 0%))
#let endnote(num, contents) = [#super[#num] #contents]
#show terms.item: it => block(spacing: 0.75em)[#strong[#it.term] #h(0.5em) #it.description]

#set page(width: 750pt, height: 1050pt, margin: (x: 110pt, top: 48pt, bottom: 48pt))
#set text(font: "Libertinus Serif", size: 11pt, lang: "en")
#set par(justify: true, leading: 0.65em, spacing: 1.2em)
#show heading: set block(above: 1.4em, below: 0.7em)
#show raw: set text(font: "DejaVu Sans Mono", size: 0.9em)
#show raw.where(block: true): it => block(inset: 8pt, width: 100%, stroke: 0.5pt + luma(200), it)
#show quote.where(block: true): it => pad(left: 1.5em, it.body)

$body$
