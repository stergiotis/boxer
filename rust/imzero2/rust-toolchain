# If you see this, run "rustup self update" to get rustup 1.23 or newer.

# NOTE: above comment is for older `rustup` (before TOML support was added),
# which will treat the first line as the toolchain name, and therefore show it
# to the user in the error, instead of "error: invalid channel name '[toolchain]'".

[toolchain]
# The toolchain the build uses; the crate's declared floor is the `rust-version`
# in Cargo.toml (1.94, measured for the since-removed h3o 0.10 and kept — the
# note there has the details). Do not lower this below that floor without
# checking the airgap bundle's Rust compile (scripts/dev/airgap-bundle.sh) first.
channel = "1.96"  # Avoid specifying a patch version here; see https://github.com/emilk/eframe_template/issues/145
components = [ "rustfmt", "clippy" ]
