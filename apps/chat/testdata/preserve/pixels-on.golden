tools t26: [{"Name":"artefact_read","Description":"Read the artefact, or a range of its lines, with each line numbered, and its revision.","Parameters":{"additionalProperties":false,"properties":{"from_line":{"minimum":1,"type":"integer"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"},"to_line":{"minimum":1,"type":"integer"}},"type":"object"}},{"Name":"artefact_outline","Description":"List the artefact's headings: level, heading path, slug, and the line span of each section.","Parameters":{"additionalProperties":false,"properties":{"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"type":"object"}},{"Name":"artefact_find","Description":"Find a text or a regular expression (RE2) in the artefact; returns line, column and the line of each match.","Parameters":{"additionalProperties":false,"properties":{"case_sensitive":{"type":"boolean"},"pattern":{"type":"string"},"regex":{"type":"boolean"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["pattern"],"type":"object"}},{"Name":"artefact_inspect","Description":"The artefact's parsed structure: frontmatter properties, links and wikilinks, embeds, tags, callouts, code blocks and footnotes, each with its line.","Parameters":{"additionalProperties":false,"properties":{"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"type":"object"}},{"Name":"artefact_lint","Description":"Check the whole artefact for markdown that renders differently from what was meant: links to missing headings, skipped heading levels, unclosed fences, invalid frontmatter, footnotes without definitions.","Parameters":{"additionalProperties":false,"properties":{"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"type":"object"}},{"Name":"artefact_write","Description":"Replace the whole artefact with text.","Parameters":{"additionalProperties":false,"properties":{"base_revision":{"description":"the revision you read","minimum":0,"type":"integer"},"text":{"type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["base_revision","text"],"type":"object"}},{"Name":"artefact_edit","Description":"Replace old_text, which must occur exactly once (or every occurrence with replace_all), with new_text.","Parameters":{"additionalProperties":false,"properties":{"base_revision":{"description":"the revision you read","minimum":0,"type":"integer"},"new_text":{"type":"string"},"old_text":{"type":"string"},"replace_all":{"type":"boolean"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["base_revision","old_text","new_text"],"type":"object"}},{"Name":"artefact_insert","Description":"Insert lines before a line number (one past the last line appends), or at the start or end of a section named by heading path.","Parameters":{"additionalProperties":false,"properties":{"at":{"description":"with heading: right after the heading line, or before the next heading","enum":["start","end"],"type":"string"},"base_revision":{"description":"the revision you read","minimum":0,"type":"integer"},"heading":{"description":"heading path, outermost first; the last element names the heading, the ones before its nearest ancestors","items":{"type":"string"},"minItems":1,"type":"array"},"line":{"minimum":1,"type":"integer"},"text":{"type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["base_revision","text"],"type":"object"}},{"Name":"artefact_replace_section","Description":"Replace the body of a section, named by heading path, keeping its heading; with_heading replaces the heading line too, and body must then start with the new heading.","Parameters":{"additionalProperties":false,"properties":{"base_revision":{"description":"the revision you read","minimum":0,"type":"integer"},"body":{"type":"string"},"heading":{"description":"heading path, outermost first; the last element names the heading, the ones before its nearest ancestors","items":{"type":"string"},"minItems":1,"type":"array"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"},"with_heading":{"type":"boolean"}},"required":["base_revision","heading","body"],"type":"object"}},{"Name":"artefact_set_frontmatter","Description":"Set or delete top-level frontmatter properties; the others, their order and comments stay.","Parameters":{"additionalProperties":false,"properties":{"base_revision":{"description":"the revision you read","minimum":0,"type":"integer"},"delete":{"items":{"type":"string"},"type":"array"},"set":{"type":"object"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["base_revision"],"type":"object"}},{"Name":"artefact_images","Description":"List the artefact's screenshots: name, size, where each came from, whether its bytes were purged, and the budget's use.","Parameters":{"additionalProperties":false,"properties":{"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"type":"object"}},{"Name":"artefact_capture","Description":"Capture windows of your task as a PNG and add it to the artefact's screenshots. The windows are drawn together, cut to their bounds; crop keeps a rect of the frame instead, in logical points.","Parameters":{"additionalProperties":false,"properties":{"base_revision":{"description":"the revision you read","minimum":0,"type":"integer"},"crop":{"additionalProperties":false,"properties":{"h":{"exclusiveMinimum":0,"type":"number"},"w":{"exclusiveMinimum":0,"type":"number"},"x":{"type":"number"},"y":{"type":"number"}},"required":["x","y","w","h"],"type":"object"},"name":{"description":"lower-case letters, digits, '.', '-' and '_', ending in .png; omitted, the chat picks screenshot-<n>.png","type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"},"windows":{"items":{"type":"integer"},"minItems":1,"type":"array"}},"required":["base_revision","windows"],"type":"object"}},{"Name":"artefact_copy_image","Description":"Add a second name on an existing screenshot's bytes, e.g. to keep it before cropping.","Parameters":{"additionalProperties":false,"properties":{"base_revision":{"description":"the revision you read","minimum":0,"type":"integer"},"from":{"type":"string"},"name":{"description":"lower-case letters, digits, '.', '-' and '_', ending in .png; omitted, the chat picks screenshot-<n>.png","type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["base_revision","from"],"type":"object"}},{"Name":"artefact_crop_image","Description":"Add a new screenshot cut out of an existing one, by a rect in its pixels (artefact_images gives each one's size).","Parameters":{"additionalProperties":false,"properties":{"base_revision":{"description":"the revision you read","minimum":0,"type":"integer"},"from":{"type":"string"},"h":{"minimum":1,"type":"integer"},"name":{"description":"lower-case letters, digits, '.', '-' and '_', ending in .png; omitted, the chat picks screenshot-<n>.png","type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"},"w":{"minimum":1,"type":"integer"},"x":{"minimum":0,"type":"integer"},"y":{"minimum":0,"type":"integer"}},"required":["base_revision","from","x","y","w","h"],"type":"object"}},{"Name":"artefact_remove_image","Description":"Remove a screenshot's name. Its bytes stay while an earlier revision names them; purge frees them for good, and a revert cannot bring them back.","Parameters":{"additionalProperties":false,"properties":{"base_revision":{"description":"the revision you read","minimum":0,"type":"integer"},"name":{"type":"string"},"purge":{"type":"boolean"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["base_revision","name"],"type":"object"}},{"Name":"request_access","Description":"Ask the person to share windows with you for a task, and optionally to let you open windows of apps. Waits for the person's decision.","Parameters":{"additionalProperties":false,"properties":{"desktop":{"description":"ask to arrange every window on the desktop, the person's own included","type":"boolean"},"destinations":{"description":"what your runs may reach, e.g. keelson:apps, keelson-bundle:<bundle> or clickhouse:host:port; publish:<prefix> lets publish_result and publish_projection publish under names with that prefix without asking each time","items":{"type":"string"},"type":"array"},"open":{"description":"apps you want to open windows of","items":{"additionalProperties":false,"properties":{"app":{"type":"string"},"count":{"maximum":4,"minimum":1,"type":"integer"}},"required":["app"],"type":"object"},"type":"array"},"plan":{"description":"one line: what you intend to do","type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["plan"],"type":"object"}},{"Name":"list_windows","Description":"List the windows of your task, with their app, mode and load (opening, ready or failed).","Parameters":{"additionalProperties":false,"properties":{"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"type":"object"}},{"Name":"describe_app","Description":"With no arguments, list every app and the operations it offers you; with app, that app's; with app and operation, the operation's argument schema.","Parameters":{"additionalProperties":false,"properties":{"app":{"description":"an app id as describe_app lists it","type":"string"},"operation":{"type":"string"},"search":{"description":"filter apps and operations by a word","type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"type":"object"}},{"Name":"read_help","Description":"Read the documentation apps ship: with search, sections across the apps matching it; with app, that app's documents and their sections; with app and doc, the document, or with section as well, that section.","Parameters":{"additionalProperties":false,"properties":{"app":{"description":"an app id as describe_app lists it","type":"string"},"doc":{"description":"a document as read_help lists it","type":"string"},"search":{"description":"words to find in the apps' help","type":"string"},"section":{"description":"a section slug as read_help lists it","type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"type":"object"}},{"Name":"call_operation","Description":"Call one operation in one window of your task; the operation's own arguments go under args.","Parameters":{"additionalProperties":false,"properties":{"args":{"type":"object"},"operation":{"type":"string"},"reason":{"description":"one line, shown to the person","type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"},"window":{"type":"integer"}},"required":["window","operation"],"type":"object"}},{"Name":"open_window","Description":"Open a window of an app your task may open; it joins your task.","Parameters":{"additionalProperties":false,"properties":{"app":{"type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["app"],"type":"object"}},{"Name":"query_windows","Description":"Run a SELECT over keelson('windows') — every open window: key, app_id, display, title, x, y, w, h, need_w, need_h, stack, active, maximized, collapsed, shown, agent_tasks — or over keelson('desktop'), the work area (work_x, work_y, work_w, work_h), the active window's key and the arrangement in progress. Rows come back as JSON lines.","Parameters":{"additionalProperties":false,"properties":{"sql":{"description":"a SELECT naming keelson('<table>'), without FORMAT","type":"string"},"table":{"enum":["windows","desktop"],"type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["table","sql"],"type":"object"}},{"Name":"arrange_windows","Description":"Lay windows out on the desktop: cascade, tile, columns (side by side), rows (stacked), or gather (bring windows back into view). Without windows it arranges every window; with them, only those, leaving the rest where they are. Needs the desktop granted (request_access with desktop true).","Parameters":{"additionalProperties":false,"properties":{"command":{"enum":["cascade","tile","columns","rows","gather"],"type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"},"windows":{"description":"window keys from query_windows; empty is every window","items":{"type":"integer"},"type":"array"}},"required":["command"],"type":"object"}},{"Name":"raise_window","Description":"Bring a window of your task, shared in act mode, to the front.","Parameters":{"additionalProperties":false,"properties":{"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"},"window":{"type":"integer"}},"required":["window"],"type":"object"}},{"Name":"place_window","Description":"Move and size a window of your task, shared in act mode: x, y is the top-left corner and w, h the outer size, in the coordinates query_windows reports. A window whose content does not fill the height or width keeps its content's size there.","Parameters":{"additionalProperties":false,"properties":{"h":{"type":"number"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"},"w":{"type":"number"},"window":{"type":"integer"},"x":{"type":"number"},"y":{"type":"number"}},"required":["window","x","y","w","h"],"type":"object"}},{"Name":"read_window_tree","Description":"Read what windows of your task show on screen, as an outline taken from one frame when you call it: each line is a widget — role, name, value — with its rect [x,y wxh] in the coordinates query_windows reports, and last the kind of part that drew it. A table's visible cells print as rows of data. Counts say what is out of view or not drawn; their contents are not in the outline. It shows the pixels, not the app's state: revisions, phase, signals and results come from the app's operations. Observe mode suffices.","Parameters":{"additionalProperties":false,"properties":{"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"},"windows":{"description":"window numbers, as list_windows gives them","items":{"type":"integer"},"minItems":1,"type":"array"}},"required":["windows"],"type":"object"}},{"Name":"point_out","Description":"Show the person something on screen: highlight parts, attach a note (callout), draw an arrow from one part to another, mark a numbered step, or dim everything else (spotlight). Name parts by a window tree you read — tree and node, e.g. {\"tree\":\"t1\",\"node\":\"#12.3\"}, or a whole table row by its row line's #60r — or a whole window. A callout already outlines its target: do not add a highlight of the same part. The mark follows its window and stays until the person clears it; marking the same id replaces it. Needs suggest or act mode on the windows. The style is the host's: you choose no colour or position.","Parameters":{"additionalProperties":false,"properties":{"id":{"description":"names the mark within your task","type":"string"},"op":{"enum":["highlight","callout","arrow","step","spotlight"],"type":"string"},"targets":{"description":"callout and step take one, arrow two (from, to)","items":{"additionalProperties":false,"properties":{"node":{"description":"a part of that tree: #12 or #12.3","type":"string"},"tree":{"description":"a tree reference, as read_window_tree gave it","type":"string"},"window":{"description":"a whole window, instead of a tree part","type":"integer"}},"type":"object"},"maxItems":8,"minItems":1,"type":"array"},"text":{"description":"the note or label, one short line; callout and step need it","type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"required":["id","op","targets"],"type":"object"}},{"Name":"clear_marks","Description":"Remove one of your marks by id, or all of yours without an id.","Parameters":{"additionalProperties":false,"properties":{"id":{"type":"string"},"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"type":"object"}},{"Name":"stop_task","Description":"End your task; the windows you opened pass to the person.","Parameters":{"additionalProperties":false,"properties":{"title":{"description":"a few words saying what this call does, for the person to read while it runs (e.g. \"Reading play's query\")","type":"string"}},"type":"object"}}]
