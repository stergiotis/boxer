#!/bin/bash
# pre-push: run scripts/ci/gate.sh on every commit about to be pushed
# (ADR-0390). Off until a developer opts in, per clone:
#
#   git config core.hooksPath scripts/dev/hooks
#
# `git push --no-verify` skips it for one push; `git config --unset
# core.hooksPath` turns it off. git feeds one line per pushed ref on stdin:
# <local ref> <local sha> <remote ref> <remote sha>. A deletion (an all-zero
# local sha) has nothing to test; each other tip is gated once.
set -euo pipefail
repo=$(git rev-parse --show-toplevel)
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
declare -A seen=()
rc=0
while read -r _lref lsha _rref _rsha; do
    [ "$lsha" = "$zero" ] && continue
    [ -n "${seen[$lsha]:-}" ] && continue
    seen[$lsha]=1
    "$repo/scripts/ci/gate.sh" "$lsha" || rc=1
done
if [ "$rc" -ne 0 ]; then
    echo "pre-push: the gate failed; nothing was pushed (git push --no-verify overrides)" >&2
fi
exit "$rc"
