SELECT "oq:app:s:::0:" AS value, count() AS n FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND ("oq:conversation:s:::0:" = 'conv-1' OR "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND has(TRAIL_REFS("oq:ref-types:sh:::0:", "oq:ref-values:sh:::0:", 'conversation'), 'conv-1'))) GROUP BY value ORDER BY n DESC, value LIMIT 50;

-- facet domain.action
SELECT concat("oq:domain:s:::0:", '.', "oq:action:s:::0:") AS value, count() AS n FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND ("oq:conversation:s:::0:" = 'conv-1' OR has(TRAIL_REFS("oq:ref-types:sh:::0:", "oq:ref-values:sh:::0:", 'conversation'), 'conv-1')) GROUP BY value ORDER BY n DESC, value LIMIT 50;

-- facet principal
SELECT "oq:principal:s:::0:" AS value, count() AS n FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND ("oq:conversation:s:::0:" = 'conv-1' OR has(TRAIL_REFS("oq:ref-types:sh:::0:", "oq:ref-values:sh:::0:", 'conversation'), 'conv-1')) GROUP BY value ORDER BY n DESC, value LIMIT 50;

-- audit by ids
SELECT toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, "id:id:u64:47::0:" AS id, "oq:domain:s:::0:" AS domain, "oq:action:s:::0:" AS action, "oq:outcome:s:::0:" AS outcome, "oq:principal:s:::0:" AS principal, "oq:principal-by:s:::0:" AS principal_by, "oq:subject:u64:::0:" AS subject, "oq:entity:s:::0:" AS entity, "oq:run:s:::0:" AS run, "oq:ref-types:sh:::0:" AS ref_types, "oq:ref-values:sh:::0:" AS ref_values, "oq:attr-keys:sh:::0:" AS attr_keys, "oq:attr-values:sh:::0:" AS attr_values, TRAIL_ATTR("oq:attr-keys:sh:::0:", "oq:attr-values:sh:::0:", 'from') AS claim_from, TRAIL_ATTR("oq:attr-keys:sh:::0:", "oq:attr-values:sh:::0:", 'from-by') AS claim_from_by FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" <= fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "id:id:u64:47::0:" IN (3, 5);

-- context before
SELECT toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, "id:id:u64:47::0:" AS id, "oq:kind:s:::0:" AS kind, "oq:run:s:::0:" AS run, "oq:app:s:::0:" AS app, "oq:instance:u64:::0:" AS instance, "oq:conversation:s:::0:" AS conversation, "oq:turn:s:::0:" AS turn, "oq:round:u32:::0:" AS round, "oq:task:s:::0:" AS task, "oq:task-epoch:u64:::0:" AS task_epoch, "oq:task-call:s:::0:" AS task_call, "oq:ref:s:::0:" AS ref, "oq:seq:u32:::0:" AS seq, "oq:parent-ref:s:::0:" AS parent_ref, "oq:status:s:::0:" AS status, "oq:subject:s:::0:" AS subject, "oq:headline:s:::0:" AS headline, "oq:text:s:::0:" AS text, "oq:confined:b:::0:" AS confined, "oq:tainted:b:::0:" AS tainted, "oq:tokens-in:u64:::0:" AS tokens_in, "oq:tokens-out:u64:::0:" AS tokens_out, "oq:elapsed-ms:u64:::0:" AS elapsed_ms FROM boxer.dm_trail_timeline WHERE "oq:run:s:::0:" = 'run-1' AND "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1790856600000000000), 'UTC') AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793448600000000000), 'UTC'), toUInt64(5)) ORDER BY "ts:ts:z64:47::0:" DESC, "id:id:u64:47::0:" DESC LIMIT 5;

-- context after
SELECT toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, "id:id:u64:47::0:" AS id, "oq:kind:s:::0:" AS kind, "oq:run:s:::0:" AS run, "oq:app:s:::0:" AS app, "oq:instance:u64:::0:" AS instance, "oq:conversation:s:::0:" AS conversation, "oq:turn:s:::0:" AS turn, "oq:round:u32:::0:" AS round, "oq:task:s:::0:" AS task, "oq:task-epoch:u64:::0:" AS task_epoch, "oq:task-call:s:::0:" AS task_call, "oq:ref:s:::0:" AS ref, "oq:seq:u32:::0:" AS seq, "oq:parent-ref:s:::0:" AS parent_ref, "oq:status:s:::0:" AS status, "oq:subject:s:::0:" AS subject, "oq:headline:s:::0:" AS headline, "oq:text:s:::0:" AS text, "oq:confined:b:::0:" AS confined, "oq:tainted:b:::0:" AS tainted, "oq:tokens-in:u64:::0:" AS tokens_in, "oq:tokens-out:u64:::0:" AS tokens_out, "oq:elapsed-ms:u64:::0:" AS elapsed_ms FROM boxer.dm_trail_timeline WHERE "oq:run:s:::0:" = 'run-1' AND "ts:ts:z64:47::0:" <= fromUnixTimestamp64Nano(toInt64(1796040600000000000), 'UTC') AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") > (fromUnixTimestamp64Nano(toInt64(1793448600000000000), 'UTC'), toUInt64(5)) ORDER BY "ts:ts:z64:47::0:" ASC, "id:id:u64:47::0:" ASC LIMIT 5;

-- previous audit
SELECT toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, "id:id:u64:47::0:" AS id, "oq:domain:s:::0:" AS domain, "oq:action:s:::0:" AS action, "oq:outcome:s:::0:" AS outcome, "oq:principal:s:::0:" AS principal, "oq:principal-by:s:::0:" AS principal_by, "oq:subject:u64:::0:" AS subject, "oq:entity:s:::0:" AS entity, "oq:run:s:::0:" AS run, "oq:ref-types:sh:::0:" AS ref_types, "oq:ref-values:sh:::0:" AS ref_values, "oq:attr-keys:sh:::0:" AS attr_keys, "oq:attr-values:sh:::0:" AS attr_values, TRAIL_ATTR("oq:attr-keys:sh:::0:", "oq:attr-values:sh:::0:", 'from') AS claim_from, TRAIL_ATTR("oq:attr-keys:sh:::0:", "oq:attr-values:sh:::0:", 'from-by') AS claim_from_by FROM boxer.dm_trail_audit_events WHERE "oq:domain:s:::0:" = 'llm-ration' AND "oq:entity:s:::0:" = 'rule:r-1' AND "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1790856600000000000), 'UTC') AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793448600000000000), 'UTC'), toUInt64(5)) ORDER BY "ts:ts:z64:47::0:" DESC, "id:id:u64:47::0:" DESC LIMIT 1;

-- gaps
SELECT toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, "id:id:u64:47::0:" AS id, "oq:domain:s:::0:" AS domain, "oq:action:s:::0:" AS action, "oq:outcome:s:::0:" AS outcome, "oq:principal:s:::0:" AS principal, "oq:principal-by:s:::0:" AS principal_by, "oq:subject:u64:::0:" AS subject, "oq:entity:s:::0:" AS entity, "oq:run:s:::0:" AS run, "oq:ref-types:sh:::0:" AS ref_types, "oq:ref-values:sh:::0:" AS ref_values, "oq:attr-keys:sh:::0:" AS attr_keys, "oq:attr-values:sh:::0:" AS attr_values, TRAIL_ATTR("oq:attr-keys:sh:::0:", "oq:attr-values:sh:::0:", 'from') AS claim_from, TRAIL_ATTR("oq:attr-keys:sh:::0:", "oq:attr-values:sh:::0:", 'from-by') AS claim_from_by FROM boxer.dm_trail_audit_events WHERE "oq:domain:s:::0:" = 'trail' AND "oq:action:s:::0:" = 'audit-gap' AND "oq:run:s:::0:" = 'run-1' AND "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" <= fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') ORDER BY "ts:ts:z64:47::0:" LIMIT 16;

-- grant pair
SELECT toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, "id:id:u64:47::0:" AS id, "oq:task:s:::0:" AS task, "oq:event:s:::0:" AS event, "oq:request:s:::0:" AS request, "oq:plan:s:::0:" AS plan, "oq:plan-digest:s:::0:" AS plan_digest, "oq:entries:sh:::0:" AS entries, "oq:launches:sh:::0:" AS launches, "oq:destinations:sh:::0:" AS destinations, "oq:calls-budget:u32:::0:" AS calls_budget, "oq:deadline-ms:i64:::0:" AS deadline_ms, "oq:decided-by:s:::0:" AS decided_by, "oq:reason:sh:::0:" AS reason FROM boxer.dm_trail_llm_agent_grants WHERE "oq:task:s:::0:" = 'task-1' AND "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1790856600000000000), 'UTC') AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") <= (fromUnixTimestamp64Nano(toInt64(1793448600000000000), 'UTC'), toUInt64(5)) ORDER BY "ts:ts:z64:47::0:" DESC, "id:id:u64:47::0:" DESC LIMIT 2;

-- rule outcome
SELECT "id:id:u64:47::0:" AS id, toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, 'outcome' AS rule, toString(concat("oq:kind:s:::0:", ' status ', "oq:status:s:::0:")) AS reason FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11)) AND ("oq:status:s:::0:" IN ('denied', 'failed', 'timeout', 'error'));

-- rule model-refused
SELECT "id:id:u64:47::0:" AS id, toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, 'model-refused' AS rule, toString(concat('model call ', "oq:subject:s:::0:", ' refused')) AS reason FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11)) AND ("oq:kind:s:::0:" = 'llmCall' AND "oq:status:s:::0:" = 'refused');

-- rule grant-widened
SELECT "id:id:u64:47::0:" AS id, toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, 'grant-widened' AS rule, toString(concat('grant of task ', "oq:task:s:::0:", ' widened')) AS reason FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11)) AND ("oq:kind:s:::0:" = 'agentGrant' AND "oq:status:s:::0:" = 'widened');

-- rule trail-row
SELECT "id:id:u64:47::0:" AS id, toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, 'trail-row' AS rule, toString(concat("oq:subject:s:::0:", ' row')) AS reason FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11)) AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.audit-gap', 'trail.audit-invalid', 'trail.config', 'trail.ditch'));

-- rule novel-action
SELECT "id:id:u64:47::0:" AS id, toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, 'novel-action' AS rule, toString(concat("oq:subject:s:::0:", ' not seen in the look-back before the window')) AS reason FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11)) AND ("oq:kind:s:::0:" = 'auditEvent' AND "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND ("oq:domain:s:::0:", "oq:action:s:::0:") NOT IN (SELECT DISTINCT "oq:domain:s:::0:", "oq:action:s:::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1790856000000000000), 'UTC'))));

-- exceptions
SELECT id, ts_ns, rule, reason FROM (SELECT "id:id:u64:47::0:" AS id, toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, 'outcome' AS rule, toString(concat("oq:kind:s:::0:", ' status ', "oq:status:s:::0:")) AS reason FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11)) AND ("oq:status:s:::0:" IN ('denied', 'failed', 'timeout', 'error')) UNION ALL SELECT "id:id:u64:47::0:" AS id, toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, 'model-refused' AS rule, toString(concat('model call ', "oq:subject:s:::0:", ' refused')) AS reason FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11)) AND ("oq:kind:s:::0:" = 'llmCall' AND "oq:status:s:::0:" = 'refused') UNION ALL SELECT "id:id:u64:47::0:" AS id, toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, 'grant-widened' AS rule, toString(concat('grant of task ', "oq:task:s:::0:", ' widened')) AS reason FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11)) AND ("oq:kind:s:::0:" = 'agentGrant' AND "oq:status:s:::0:" = 'widened') UNION ALL SELECT "id:id:u64:47::0:" AS id, toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, 'trail-row' AS rule, toString(concat("oq:subject:s:::0:", ' row')) AS reason FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11)) AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.audit-gap', 'trail.audit-invalid', 'trail.config', 'trail.ditch')) UNION ALL SELECT "id:id:u64:47::0:" AS id, toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, 'novel-action' AS rule, toString(concat("oq:subject:s:::0:", ' not seen in the look-back before the window')) AS reason FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11)) AND ("oq:kind:s:::0:" = 'auditEvent' AND "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND ("oq:domain:s:::0:", "oq:action:s:::0:") NOT IN (SELECT DISTINCT "oq:domain:s:::0:", "oq:action:s:::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1790856000000000000), 'UTC'))))) ORDER BY ts_ns DESC, id DESC, rule LIMIT 10000;

-- reviews
SELECT "oq:trail-row:u64:::0:" AS row_id, toUnixTimestamp64Nano(max("ts:ts:z64:47::0:")) AS ts_ns, argMax("oq:mark:s:::0:", ("ts:ts:z64:47::0:", "id:id:u64:47::0:")) AS mark, argMax("oq:reason:s:::0:", ("ts:ts:z64:47::0:", "id:id:u64:47::0:")) AS reason, argMax("oq:rule:s:::0:", ("ts:ts:z64:47::0:", "id:id:u64:47::0:")) AS rule, argMax("oq:principal:s:::0:", ("ts:ts:z64:47::0:", "id:id:u64:47::0:")) AS principal, toUInt64(count()) AS marks FROM boxer.dm_trail_reviews WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "oq:trail-row:u64:::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") >= (fromUnixTimestamp64Nano(toInt64(1793448300000000000), 'UTC'), toUInt64(11))) GROUP BY row_id;

-- as of
SELECT toUnixTimestamp64Nano("ts:ts:z64:47::0:") AS ts_ns, "id:id:u64:47::0:" AS id, "oq:domain:s:::0:" AS domain, "oq:action:s:::0:" AS action, "oq:outcome:s:::0:" AS outcome, "oq:principal:s:::0:" AS principal, "oq:principal-by:s:::0:" AS principal_by, "oq:subject:u64:::0:" AS subject, "oq:entity:s:::0:" AS entity, "oq:run:s:::0:" AS run, "oq:ref-types:sh:::0:" AS ref_types, "oq:ref-values:sh:::0:" AS ref_values, "oq:attr-keys:sh:::0:" AS attr_keys, "oq:attr-values:sh:::0:" AS attr_values, TRAIL_ATTR("oq:attr-keys:sh:::0:", "oq:attr-values:sh:::0:", 'from') AS claim_from, TRAIL_ATTR("oq:attr-keys:sh:::0:", "oq:attr-values:sh:::0:", 'from-by') AS claim_from_by FROM boxer.dm_trail_audit_events WHERE "oq:entity:s:::0:" = 'rule:r-1' AND "ts:ts:z64:47::0:" <= fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1790859600000000000), 'UTC') ORDER BY "ts:ts:z64:47::0:" DESC, "id:id:u64:47::0:" DESC LIMIT 1;

-- matrix app × operation
SELECT toString("oq:app:s:::0:") AS actor, toString("oq:subject:s:::0:") AS object, count() AS n, toString(argMax("oq:status:s:::0:", "ts:ts:z64:47::0:")) AS last_outcome FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) GROUP BY actor, object HAVING actor != '' AND object != '' ORDER BY n DESC, actor, object LIMIT 10000;

-- matrix window × operation, no filter
SELECT toString(concat("oq:run:s:::0:", ':', toString("oq:instance:u64:::0:"))) AS actor, toString("oq:subject:s:::0:") AS object, count() AS n, toString(argMax("oq:status:s:::0:", "ts:ts:z64:47::0:")) AS last_outcome FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' GROUP BY actor, object HAVING actor != '' AND object != '' ORDER BY n DESC, actor, object LIMIT 10000;

-- matrix principal × entity
SELECT toString("oq:principal:s:::0:") AS actor, toString("oq:entity:s:::0:") AS object, count() AS n, toString(argMax("oq:outcome:s:::0:", "ts:ts:z64:47::0:")) AS last_outcome FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1'))) GROUP BY actor, object HAVING actor != '' AND object != '' ORDER BY n DESC, actor, object LIMIT 10000;

-- matrix app × subject, no filter
SELECT toString("oq:app:s:::0:") AS actor, toString(if("oq:subject:u64:::0:" = 0, '', toString("oq:subject:u64:::0:"))) AS object, count() AS n, toString(argMax("oq:outcome:s:::0:", "ts:ts:z64:47::0:")) AS last_outcome FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' GROUP BY actor, object HAVING actor != '' AND object != '' ORDER BY n DESC, actor, object LIMIT 10000;

-- dotted by window
SELECT toString(concat("oq:run:s:::0:", ':', toString("oq:instance:u64:::0:"))) AS key, toInt64(toUnixTimestamp(toStartOfInterval("ts:ts:z64:47::0:", INTERVAL 60 SECOND))) AS bucket, count() AS n FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1')) AND ("ts:ts:z64:47::0:", "id:id:u64:47::0:") < (fromUnixTimestamp64Nano(toInt64(1793449800000000000), 'UTC'), toUInt64(99)) GROUP BY key, bucket HAVING key != '' ORDER BY key, bucket LIMIT 20000;

-- dotted by conversation
SELECT toString("oq:conversation:s:::0:") AS key, toInt64(toUnixTimestamp(toStartOfInterval("ts:ts:z64:47::0:", INTERVAL 60 SECOND))) AS bucket, count() AS n FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND ("oq:conversation:s:::0:" = 'conv-1' OR "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND has(TRAIL_REFS("oq:ref-types:sh:::0:", "oq:ref-values:sh:::0:", 'conversation'), 'conv-1'))) GROUP BY key, bucket HAVING key != '' ORDER BY key, bucket LIMIT 20000;

-- dotted by entity
SELECT toString("oq:entity:s:::0:") AS key, toInt64(toUnixTimestamp(toStartOfInterval("ts:ts:z64:47::0:", INTERVAL 60 SECOND))) AS bucket, count() AS n FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_timeline WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:run:s:::0:" = 'run-1' AND "oq:kind:s:::0:" IN ('auditEvent') AND NOT "oq:status:s:::0:" IN ('ok') AND "oq:app:s:::0:" IN ('apps/x') AND ("oq:kind:s:::0:" = 'auditEvent' AND "oq:subject:s:::0:" IN ('trail.config')) AND NOT "id:id:u64:47::0:" IN (SELECT "id:id:u64:47::0:" FROM boxer.dm_trail_audit_events WHERE "ts:ts:z64:47::0:" >= fromUnixTimestamp64Nano(toInt64(1793448000000000000), 'UTC') AND "ts:ts:z64:47::0:" < fromUnixTimestamp64Nano(toInt64(1793451600000000000), 'UTC') AND "oq:principal:s:::0:" IN ('p-1'))) GROUP BY key, bucket HAVING key != '' ORDER BY key, bucket LIMIT 20000;
