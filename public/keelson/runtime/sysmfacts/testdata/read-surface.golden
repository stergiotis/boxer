# The sysmetrics read surface, expanded (ADR-0184 §SD6).
#
# Each block is one authored query and what the client-side LW_GET* pass
# ships to the server. A changed line is a changed physical column, so a
# re-aspected section or a renamed membership goes red here rather than at
# the first dump against a real server.
#
# Regenerate with BOXER_SYSMFACTS_READSURFACE_REGEN=1 go test ./public/keelson/runtime/sysmfacts/...

## cpu
-- authored
SELECT LW_GET('symbol', 'sysmCpuHost', 'chan:low-card-ref') AS host,
       arrayElement(LW_GET_LIST('u8Array', 'sysmCpuTotalPct', 'chan:low-card-ref'), 1) AS total_pct,
       LW_GET_LIST('u8Array', 'sysmCpuPerCorePct', 'chan:low-card-ref') AS per_core_pct,
       LW_GET_LIST('u32Array', 'sysmCpuPerCoreFreqMhz', 'chan:low-card-ref') AS per_core_freq_mhz,
       arrayElement(LW_GET_LIST('f32Array', 'sysmCpuLoadAvg1', 'chan:low-card-ref'), 1) AS load_avg_1,
       LW_GET_LIST('f32Array', 'sysmCpuUsageWatts', 'chan:low-card-ref') AS usage_watts,
       LW_GET_LIST('i32Array', 'sysmCpuActiveCpus', 'chan:low-card-ref') AS active_cpus
FROM boxer.facts
-- expanded
SELECT LW_VALUE_BY_TAG_EQUAL("tv:symbol:value:val:s:124::I:0::data", "tv:symbol:lr:lr:u64:1247:::0::data", 2305843022098595843, LW_RAGGED_PARENT_IDS("tv:symbol:lrcard:lrcard:u64:4E:::0::data")) AS host,
       arrayElement(LW_LIST_BY_TAG_EQUAL("tv:u8Array:value:val:u8h:4:::0::data", "tv:u8Array:len:len:u64:4D:::0::data", "tv:u8Array:lr:lr:u64:1247:::0::data", 2305843022098595846, LW_RAGGED_PARENT_IDS("tv:u8Array:lrcard:lrcard:u64:4E:::0::data")), 1) AS total_pct,
       LW_LIST_BY_TAG_EQUAL("tv:u8Array:value:val:u8h:4:::0::data", "tv:u8Array:len:len:u64:4D:::0::data", "tv:u8Array:lr:lr:u64:1247:::0::data", 2305843022098595847, LW_RAGGED_PARENT_IDS("tv:u8Array:lrcard:lrcard:u64:4E:::0::data")) AS per_core_pct,
       LW_LIST_BY_TAG_EQUAL("tv:u32Array:value:val:u32h:4:::0::data", "tv:u32Array:len:len:u64:4D:::0::data", "tv:u32Array:lr:lr:u64:1247:::0::data", 2305843022098595848, LW_RAGGED_PARENT_IDS("tv:u32Array:lrcard:lrcard:u64:4E:::0::data")) AS per_core_freq_mhz,
       arrayElement(LW_LIST_BY_TAG_EQUAL("tv:f32Array:value:val:f32h:4A:::0::data", "tv:f32Array:len:len:u64:4D:::0::data", "tv:f32Array:lr:lr:u64:1247:::0::data", 2305843022098595849, LW_RAGGED_PARENT_IDS("tv:f32Array:lrcard:lrcard:u64:4E:::0::data")), 1) AS load_avg_1,
       LW_LIST_BY_TAG_EQUAL("tv:f32Array:value:val:f32h:4A:::0::data", "tv:f32Array:len:len:u64:4D:::0::data", "tv:f32Array:lr:lr:u64:1247:::0::data", 2305843022098595852, LW_RAGGED_PARENT_IDS("tv:f32Array:lrcard:lrcard:u64:4E:::0::data")) AS usage_watts,
       LW_LIST_BY_TAG_EQUAL("tv:i32Array:value:val:i32h:4:::0::data", "tv:i32Array:len:len:u64:4D:::0::data", "tv:i32Array:lr:lr:u64:1247:::0::data", 2305843022098595853, LW_RAGGED_PARENT_IDS("tv:i32Array:lrcard:lrcard:u64:4E:::0::data")) AS active_cpus
FROM boxer.facts

## cpuinfo
-- authored
SELECT LW_GET('symbol', 'sysmCpuInfoHost', 'chan:low-card-ref') AS host,
       LW_GET('symbol', 'sysmCpuModelName', 'chan:low-card-ref') AS model_name,
       arrayElement(LW_GET_LIST('i32Array', 'sysmCpuLogicalCores', 'chan:low-card-ref'), 1) AS logical_cores
FROM boxer.facts
-- expanded
SELECT LW_VALUE_BY_TAG_EQUAL("tv:symbol:value:val:s:124::I:0::data", "tv:symbol:lr:lr:u64:1247:::0::data", 2305843022098595844, LW_RAGGED_PARENT_IDS("tv:symbol:lrcard:lrcard:u64:4E:::0::data")) AS host,
       LW_VALUE_BY_TAG_EQUAL("tv:symbol:value:val:s:124::I:0::data", "tv:symbol:lr:lr:u64:1247:::0::data", 2305843022098595854, LW_RAGGED_PARENT_IDS("tv:symbol:lrcard:lrcard:u64:4E:::0::data")) AS model_name,
       arrayElement(LW_LIST_BY_TAG_EQUAL("tv:i32Array:value:val:i32h:4:::0::data", "tv:i32Array:len:len:u64:4D:::0::data", "tv:i32Array:lr:lr:u64:1247:::0::data", 2305843022098595855, LW_RAGGED_PARENT_IDS("tv:i32Array:lrcard:lrcard:u64:4E:::0::data")), 1) AS logical_cores
FROM boxer.facts

