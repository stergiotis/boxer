-- server
CREATE USER IF NOT EXISTS `agent42` IDENTIFIED WITH no_password HOST LOCAL;
CREATE SETTINGS PROFILE OR REPLACE `agent42_p` SETTINGS readonly = 2 READONLY, `custom_agent_run` = 'cell/run-1' READONLY, `custom_agent_conversation` = 'chat-1' READONLY, `custom_agent_app` = 'github.com/x/chat' READONLY TO `agent42`;
CREATE OR REPLACE VIEW `harness`.`my_run` SQL SECURITY DEFINER DEFINER = `default` AS SELECT base.`run` AS `run`, base.`ordinal` AS `ordinal`, base.`at_ms` AS `at_ms`, base.`kind` AS `kind`, base.`key` AS `key`, base.`role` AS `role`, base.`body` AS `body`, base.`calls` AS `calls`, base.`body_digest` AS `body_digest`, base.`calls_digest` AS `calls_digest`, base.`name` AS `name`, base.`book` AS `book`, base.`form` AS `form`, base.`target` AS `target`, base.`from` AS `from`, base.`effect` AS `effect`, base.`turn` AS `turn`, base.`label_level` AS `label_level`, base.`label_tier` AS `label_tier`, base.`label_exposure` AS `label_exposure`, base.`label_origin` AS `label_origin`, base.`writer_run` AS `writer_run`, base.`writer_turn` AS `writer_turn`, base.`writer_ordinal` AS `writer_ordinal`, base.`prev` AS `prev`, base.`digest` AS `digest`, base.`key_id` AS `key_id`, base.`parent` AS `parent`, base.`attachments` AS `attachments` FROM `agent_run_entries` AS base WHERE base.`run` = getSettingOrDefault('custom_agent_run', '') SETTINGS `custom_agent_relation` = 'my_run';
GRANT SELECT ON `harness`.`my_run` TO `agent42`;
CREATE ROW POLICY OR REPLACE `my_run_backstop` ON `agent_run_entries` AS RESTRICTIVE USING getSettingOrDefault('custom_agent_relation', '') != 'my_run' OR `run` = getSettingOrDefault('custom_agent_run', '') TO ALL;
CREATE OR REPLACE VIEW `harness`.`my_conversation` SQL SECURITY DEFINER DEFINER = `default` AS SELECT base.`run` AS `run`, base.`ordinal` AS `ordinal`, base.`at_ms` AS `at_ms`, base.`kind` AS `kind`, base.`key` AS `key`, base.`role` AS `role`, base.`body` AS `body`, base.`calls` AS `calls`, base.`body_digest` AS `body_digest`, base.`calls_digest` AS `calls_digest`, base.`name` AS `name`, base.`book` AS `book`, base.`form` AS `form`, base.`target` AS `target`, base.`from` AS `from`, base.`effect` AS `effect`, base.`turn` AS `turn`, base.`label_level` AS `label_level`, base.`label_tier` AS `label_tier`, base.`label_exposure` AS `label_exposure`, base.`label_origin` AS `label_origin`, base.`writer_run` AS `writer_run`, base.`writer_turn` AS `writer_turn`, base.`writer_ordinal` AS `writer_ordinal`, base.`prev` AS `prev`, base.`digest` AS `digest`, base.`key_id` AS `key_id`, base.`parent` AS `parent`, base.`attachments` AS `attachments` FROM `agent_run_entries` AS base WHERE (base.`run` IN (SELECT `id` FROM `agent_runs` WHERE `conversation` = getSettingOrDefault('custom_agent_conversation', ''))) AND base.`run` != getSettingOrDefault('custom_agent_run', '') SETTINGS `custom_agent_relation` = 'my_conversation';
GRANT SELECT ON `harness`.`my_conversation` TO `agent42`;
CREATE ROW POLICY OR REPLACE `my_conversation_backstop` ON `agent_run_entries` AS RESTRICTIVE USING getSettingOrDefault('custom_agent_relation', '') != 'my_conversation' OR (`run` IN (SELECT `id` FROM `agent_runs` WHERE `conversation` = getSettingOrDefault('custom_agent_conversation', ''))) AND `run` != getSettingOrDefault('custom_agent_run', '') TO ALL;
CREATE OR REPLACE VIEW `harness`.`agent_history` SQL SECURITY DEFINER DEFINER = `default` AS SELECT base.`run` AS `run`, base.`ordinal` AS `ordinal`, base.`at_ms` AS `at_ms`, base.`kind` AS `kind`, base.`key` AS `key`, base.`role` AS `role`, base.`body_digest` AS `body_digest`, base.`calls_digest` AS `calls_digest`, base.`name` AS `name`, base.`book` AS `book`, base.`form` AS `form`, base.`target` AS `target`, base.`from` AS `from`, base.`effect` AS `effect`, base.`turn` AS `turn`, base.`label_level` AS `label_level`, base.`label_tier` AS `label_tier`, base.`label_exposure` AS `label_exposure`, base.`label_origin` AS `label_origin`, base.`writer_run` AS `writer_run`, base.`writer_turn` AS `writer_turn`, base.`writer_ordinal` AS `writer_ordinal`, base.`prev` AS `prev`, base.`digest` AS `digest`, base.`key_id` AS `key_id`, base.`parent` AS `parent`, length(base.`body`) AS `body_bytes`, length(base.`calls`) AS `calls_bytes`, length(base.`attachments`) AS `attachments_bytes` FROM `agent_run_entries` AS base WHERE base.`run` IN (SELECT `id` FROM `agent_runs` WHERE `owner_app` = getSettingOrDefault('custom_agent_app', '')) SETTINGS `custom_agent_relation` = 'agent_history';
GRANT SELECT ON `harness`.`agent_history` TO `agent42`;
CREATE ROW POLICY OR REPLACE `agent_history_backstop` ON `agent_run_entries` AS RESTRICTIVE USING getSettingOrDefault('custom_agent_relation', '') != 'agent_history' OR `run` IN (SELECT `id` FROM `agent_runs` WHERE `owner_app` = getSettingOrDefault('custom_agent_app', '')) TO ALL;
CREATE OR REPLACE VIEW `harness`.`notes` SQL SECURITY DEFINER DEFINER = `default` AS SELECT base.`run` AS `run`, base.`ord` AS `ord`, base.`note` AS `note`, if(hasAny(base.`memberships`, ['credential', 'personal']), defaultValueOfTypeName(toTypeName(base.`contact`)), base.`contact`) AS `contact`, arrayFilter(x -> NOT has(['credential', 'personal'], x), base.`memberships`) AS `memberships`, arrayFilter(x -> has(['credential', 'personal'], x), base.`memberships`) AS `withheld_memberships`, arrayMap(x -> 'withhold:notes', arrayFilter(x -> has(['credential', 'personal'], x), base.`memberships`)) AS `withheld_policy` FROM `scratch`.`notes` AS base WHERE base.`run` = getSettingOrDefault('custom_agent_run', '') SETTINGS `custom_agent_relation` = 'notes';
GRANT SELECT ON `harness`.`notes` TO `agent42`;
CREATE ROW POLICY OR REPLACE `notes_backstop` ON `scratch`.`notes` AS RESTRICTIVE USING getSettingOrDefault('custom_agent_relation', '') != 'notes' OR `run` = getSettingOrDefault('custom_agent_run', '') TO ALL;
-- worker
CREATE OR REPLACE VIEW `my_run` AS SELECT base.`run` AS `run`, base.`ordinal` AS `ordinal`, base.`at_ms` AS `at_ms`, base.`kind` AS `kind`, base.`key` AS `key`, base.`role` AS `role`, base.`body` AS `body`, base.`calls` AS `calls`, base.`body_digest` AS `body_digest`, base.`calls_digest` AS `calls_digest`, base.`name` AS `name`, base.`book` AS `book`, base.`form` AS `form`, base.`target` AS `target`, base.`from` AS `from`, base.`effect` AS `effect`, base.`turn` AS `turn`, base.`label_level` AS `label_level`, base.`label_tier` AS `label_tier`, base.`label_exposure` AS `label_exposure`, base.`label_origin` AS `label_origin`, base.`writer_run` AS `writer_run`, base.`writer_turn` AS `writer_turn`, base.`writer_ordinal` AS `writer_ordinal`, base.`prev` AS `prev`, base.`digest` AS `digest`, base.`key_id` AS `key_id`, base.`parent` AS `parent`, base.`attachments` AS `attachments` FROM `agent_run_entries` AS base WHERE base.`run` = 'cell/run-1';
CREATE OR REPLACE VIEW `my_conversation` AS SELECT base.`run` AS `run`, base.`ordinal` AS `ordinal`, base.`at_ms` AS `at_ms`, base.`kind` AS `kind`, base.`key` AS `key`, base.`role` AS `role`, base.`body` AS `body`, base.`calls` AS `calls`, base.`body_digest` AS `body_digest`, base.`calls_digest` AS `calls_digest`, base.`name` AS `name`, base.`book` AS `book`, base.`form` AS `form`, base.`target` AS `target`, base.`from` AS `from`, base.`effect` AS `effect`, base.`turn` AS `turn`, base.`label_level` AS `label_level`, base.`label_tier` AS `label_tier`, base.`label_exposure` AS `label_exposure`, base.`label_origin` AS `label_origin`, base.`writer_run` AS `writer_run`, base.`writer_turn` AS `writer_turn`, base.`writer_ordinal` AS `writer_ordinal`, base.`prev` AS `prev`, base.`digest` AS `digest`, base.`key_id` AS `key_id`, base.`parent` AS `parent`, base.`attachments` AS `attachments` FROM `agent_run_entries` AS base WHERE (base.`run` IN (SELECT `id` FROM `agent_runs` WHERE `conversation` = 'chat-1')) AND base.`run` != 'cell/run-1';
CREATE OR REPLACE VIEW `agent_history` AS SELECT base.`run` AS `run`, base.`ordinal` AS `ordinal`, base.`at_ms` AS `at_ms`, base.`kind` AS `kind`, base.`key` AS `key`, base.`role` AS `role`, base.`body_digest` AS `body_digest`, base.`calls_digest` AS `calls_digest`, base.`name` AS `name`, base.`book` AS `book`, base.`form` AS `form`, base.`target` AS `target`, base.`from` AS `from`, base.`effect` AS `effect`, base.`turn` AS `turn`, base.`label_level` AS `label_level`, base.`label_tier` AS `label_tier`, base.`label_exposure` AS `label_exposure`, base.`label_origin` AS `label_origin`, base.`writer_run` AS `writer_run`, base.`writer_turn` AS `writer_turn`, base.`writer_ordinal` AS `writer_ordinal`, base.`prev` AS `prev`, base.`digest` AS `digest`, base.`key_id` AS `key_id`, base.`parent` AS `parent`, length(base.`body`) AS `body_bytes`, length(base.`calls`) AS `calls_bytes`, length(base.`attachments`) AS `attachments_bytes` FROM `agent_run_entries` AS base WHERE base.`run` IN (SELECT `id` FROM `agent_runs` WHERE `owner_app` = 'github.com/x/chat');
CREATE OR REPLACE VIEW `notes` AS SELECT base.`run` AS `run`, base.`ord` AS `ord`, base.`note` AS `note`, if(hasAny(base.`memberships`, ['credential', 'personal']), defaultValueOfTypeName(toTypeName(base.`contact`)), base.`contact`) AS `contact`, arrayFilter(x -> NOT has(['credential', 'personal'], x), base.`memberships`) AS `memberships`, arrayFilter(x -> has(['credential', 'personal'], x), base.`memberships`) AS `withheld_memberships`, arrayMap(x -> 'withhold:notes', arrayFilter(x -> has(['credential', 'personal'], x), base.`memberships`)) AS `withheld_policy` FROM `scratch`.`notes` AS base WHERE base.`run` = 'cell/run-1';
-- laws
SELECT * FROM (SELECT base.`run` AS `run`, base.`ord` AS `ord`, base.`note` AS `note`, if(hasAny(base.`memberships`, ['credential', 'personal']), defaultValueOfTypeName(toTypeName(base.`contact`)), base.`contact`) AS `contact`, arrayFilter(x -> NOT has(['credential', 'personal'], x), base.`memberships`) AS `memberships`, arrayFilter(x -> has(['credential', 'personal'], x), base.`memberships`) AS `withheld_memberships`, arrayMap(x -> 'withhold:notes', arrayFilter(x -> has(['credential', 'personal'], x), base.`memberships`)) AS `withheld_policy` FROM `scratch`.`notes` AS base WHERE base.`run` = 'cell/run-1') WHERE length(`withheld_memberships`) != length(`withheld_policy`);
SELECT * FROM (SELECT base.`run` AS `run`, base.`ord` AS `ord`, base.`note` AS `note`, if(hasAny(base.`memberships`, ['credential', 'personal']), defaultValueOfTypeName(toTypeName(base.`contact`)), base.`contact`) AS `contact`, arrayFilter(x -> NOT has(['credential', 'personal'], x), base.`memberships`) AS `memberships`, arrayFilter(x -> has(['credential', 'personal'], x), base.`memberships`) AS `withheld_memberships`, arrayMap(x -> 'withhold:notes', arrayFilter(x -> has(['credential', 'personal'], x), base.`memberships`)) AS `withheld_policy` FROM `scratch`.`notes` AS base WHERE base.`run` = 'cell/run-1') WHERE hasAny(`memberships`, ['credential', 'personal']);
SELECT a.`ord` FROM (SELECT base.`run` AS `run`, base.`ord` AS `ord`, base.`note` AS `note`, if(hasAny(base.`memberships`, ['credential', 'personal']), defaultValueOfTypeName(toTypeName(base.`contact`)), base.`contact`) AS `contact`, arrayFilter(x -> NOT has(['credential', 'personal'], x), base.`memberships`) AS `memberships`, arrayFilter(x -> has(['credential', 'personal'], x), base.`memberships`) AS `withheld_memberships`, arrayMap(x -> 'withhold:notes', arrayFilter(x -> has(['credential', 'personal'], x), base.`memberships`)) AS `withheld_policy` FROM `scratch`.`notes` AS base WHERE base.`run` = 'cell/run-1') AS a INNER JOIN `scratch`.`notes` AS b ON a.`ord` = b.`ord` WHERE length(b.`memberships`) != length(a.`memberships`) + length(a.`withheld_memberships`);
SELECT count() AS n, sum(cityHash64(`body`)) AS h FROM `my_run`;
SELECT count() AS n, sum(cityHash64(`body`)) AS h FROM (SELECT base.`run` AS `run`, base.`ordinal` AS `ordinal`, base.`at_ms` AS `at_ms`, base.`kind` AS `kind`, base.`key` AS `key`, base.`role` AS `role`, base.`body` AS `body`, base.`calls` AS `calls`, base.`body_digest` AS `body_digest`, base.`calls_digest` AS `calls_digest`, base.`name` AS `name`, base.`book` AS `book`, base.`form` AS `form`, base.`target` AS `target`, base.`from` AS `from`, base.`effect` AS `effect`, base.`turn` AS `turn`, base.`label_level` AS `label_level`, base.`label_tier` AS `label_tier`, base.`label_exposure` AS `label_exposure`, base.`label_origin` AS `label_origin`, base.`writer_run` AS `writer_run`, base.`writer_turn` AS `writer_turn`, base.`writer_ordinal` AS `writer_ordinal`, base.`prev` AS `prev`, base.`digest` AS `digest`, base.`key_id` AS `key_id`, base.`parent` AS `parent`, base.`attachments` AS `attachments` FROM `agent_run_entries` AS base WHERE base.`run` = 'cell/run-1');
